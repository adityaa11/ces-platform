  "sources": [
    { "id": "F3-A", "kind": "paragraph", "page": 1, "locator": "p1:block:a", "text": "Independent safe paragraph A establishes the weekly review cadence.", "content_sha256": "a16146cea89d086932a7152f32d54d5317eb3ecdc51122fdbaee984f73a4db41", "verified": true, "eligibility": "independent_eligible" },
    { "id": "F3-B", "kind": "paragraph", "page": 1, "locator": "p1:block:b", "text": "Independent safe paragraph B identifies the request register.", "content_sha256": "1704034f81e326926b64a16c5d8faaa1173cbf72fb00a458da0e5154c74c6c15", "verified": true, "eligibility": "independent_eligible" },
    { "id": "F3-C", "kind": "table", "page": 2, "locator": "p2:table:large", "text": "MERGED HEADER AND SHARED CONDITION: This indivisible synthetic table lists category limits under a common qualifying condition. The table cannot be row-split because the merged header governs every row. ", "repeat": 20, "content_sha256": "07bce547593fc554b48bd302ba43ee136c9bf32b11b0711987ace9ccf5d7be4b", "verified": true, "indivisible": true, "eligibility": "independent_eligible" },
    { "id": "F3-D", "kind": "paragraph", "page": 2, "locator": "p2:block:condition", "text": "For every request in the large table, the stated limit is per calendar week and applies even when processing is delegated.", "content_sha256": "c762365eba78b3b7732783dd13e01dabb82d1097aac027c839d4a74565b3299c", "verified": true, "eligibility": "independent_eligible", "independent_proposition": "The stated table limit applies per calendar week even when processing is delegated." },
    { "id": "F3-E", "kind": "paragraph", "page": 3, "locator": "p3:block:e", "text": "Cycle member E is meaningful only with its linked exception.", "content_sha256": "a1960f08f2e54ff52a3503d6ca9d520a095f541b47cb260c251532be41877f1a", "verified": true, "eligibility": "independent_eligible" },
    { "id": "F3-F", "kind": "paragraph", "page": 3, "locator": "p3:block:f", "text": "Cycle member F is meaningful only with its linked base rule.", "content_sha256": "09b761ec8fe7da54131774f7c8719df87eb0ba74b6f27ee3babef39a9fd49803", "verified": true, "eligibility": "independent_eligible" },
    { "id": "F3-H", "kind": "paragraph", "page": 4, "locator": "p4:block:h", "text": "The listed exception applies only to requests already approved.", "content_sha256": "c97f28fd7852ce7955a49425ee06dcca69ea48f777436540673edecaedda9667", "verified": true, "eligibility": "independent_eligible" },
    { "id": "F3-I", "kind": "paragraph", "page": 4, "locator": "p4:block:i", "text": "For this section, an approved request has a signed approval record.", "content_sha256": "a99b7d69176fb17075d3b0425419524702c566c8f200f33fd1a74e53dce99656", "verified": true, "eligibility": "independent_eligible" },
    { "id": "F3-J", "kind": "paragraph", "page": 4, "locator": "p4:block:j", "text": "A signed approval record bears the designated approver signature.", "content_sha256": "dff253b0cf63166d52aadb5b3e7dd5b4581ea01108509c7716964e864139bf8f", "verified": true, "eligibility": "independent_eligible" }
  ],
