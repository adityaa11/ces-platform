# Default repository-wide fixture-authoring mode.
# Valid values: codex | agents_bridge
SKILLS_MODE=codex

# Local PostgreSQL development settings. These are sample values, not secrets.
POSTGRES_DB=atlas_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=atlas_local_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:atlas_local_dev_only@localhost:5432/atlas_dev
ATLAS_APP_PASSWORD=atlas_app_local_dev_only
AGENTS_BRIDGE_PASSWORD=agents_bridge_local_dev_only
AGENTS_BRIDGE_SERVICE_CREDENTIAL=agents_bridge_service_local_dev_only_32
ATLAS_DOCUMENT_STORE_ROOT=.atlas-data

# Better Auth identity/session boundary. Use a unique 32+ character secret outside local development.
BETTER_AUTH_SECRET=replace_with_a_local_only_32_character_or_longer_secret
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001

# Optional Anthropic live-qualification credential. For SEMSPIKE-007, copy
# this file to .env and set ANTHROPIC_API_KEY there. Keep .env local and never
# commit it. Mocked tests and ordinary stack boot do not need it.
# ANTHROPIC_API_KEY=
