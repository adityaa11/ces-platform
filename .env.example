# Default repository-wide fixture-authoring mode.
# Valid values: codex | agents_bridge
SKILLS_MODE=codex

# Local PostgreSQL development settings. These are sample values, not secrets.
POSTGRES_DB=atlas_dev
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_local_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://atlas:atlas_local_dev_only@localhost:5432/atlas_dev
ATLAS_APP_PASSWORD=atlas_app_local_dev_only
AGENTS_BRIDGE_PASSWORD=agents_bridge_local_dev_only
AGENTS_BRIDGE_SERVICE_CREDENTIAL=agents_bridge_service_local_dev_only_32
ATLAS_DOCUMENT_STORE_ROOT=.atlas-data

# Better Auth identity/session boundary. Use a unique 32+ character secret outside local development.
BETTER_AUTH_SECRET=replace_with_a_local_only_32_character_or_longer_secret
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001

# Optional Mistral live-qualification credentials. Keep this value local and
# never commit it. Mocked tests and ordinary stack boot do not need it.
# MISTRAL_API_KEY=
# MISTRAL_STRUCTURED_MODEL=mistral-large-3-25-12
# MISTRAL_CHAT_MODEL=mistral-small-4-0-26-03
# MISTRAL_OCR_MODEL=mistral-ocr-4-1
# MISTRAL_ZDR_APPROVED=false
# MISTRAL_MAX_DOCUMENT_BYTES=20971520
# MISTRAL_MAX_REQUEST_BYTES=2097152
# MISTRAL_MAX_RESPONSE_BYTES=10485760
# MISTRAL_MAX_STREAM_BYTES=10485760
# MISTRAL_TIMEOUT_MS=30000
# MISTRAL_RETRY_MAX_ATTEMPTS=2
# MISTRAL_RETRY_DELAY_MS=250
