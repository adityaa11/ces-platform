{
  "contractVersion": "1.0",
  "id": "atlas.fixture-verification",
  "version": "1.1.0",
  "instructionFile": "SKILL.md",
  "execution": { "kind": "verification", "resultDisposition": "advisory-only", "requiresDeterministicValidation": true },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["repository", "projections"],
    "properties": {
      "repository": { "type": "object", "required": ["branches", "revisions", "materializedStates"], "properties": { "branches": { "type": "array" }, "revisions": { "type": "array" }, "materializedStates": { "type": "array" } } },
      "projections": { "type": "object", "required": ["branchId", "headRevisionId", "surfaces"], "properties": { "branchId": { "type": "string", "minLength": 1 }, "headRevisionId": { "type": "string", "minLength": 1 }, "surfaces": { "type": "array" } } },
      "checks": { "type": "array", "items": { "type": "string" } }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["skillId", "skillVersion", "executionProvenance", "status", "checks"],
    "properties": {
      "skillId": { "const": "atlas.fixture-verification" },
      "skillVersion": { "const": "1.1.0" },
      "executionProvenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skillId", "skillVersion", "mode"],
        "properties": {
          "skillId": { "const": "atlas.fixture-verification" },
          "skillVersion": { "const": "1.1.0" },
          "mode": { "enum": ["codex", "agents_bridge"] }
        }
      },
      "status": { "enum": ["pass", "fail", "inconclusive"] },
      "checks": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["checkId", "status", "detail"], "properties": { "checkId": { "type": "string", "minLength": 1 }, "status": { "enum": ["pass", "fail", "inconclusive"] }, "detail": { "type": "string", "minLength": 1 } } } }
    }
  }
}
