{
  "contractVersion": "1.0",
  "id": "atlas.prd-extraction",
  "version": "1.2.0",
  "instructionFile": "SKILL.md",
  "execution": {
    "kind": "reasoning",
    "resultDisposition": "candidate-only",
    "requiresDeterministicValidation": true
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["artifact", "pages"],
    "properties": {
      "artifact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "type", "name", "sha256"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "type": { "enum": ["prd", "addendum"] },
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "minLength": 1 },
          "workspaceId": { "type": "string", "minLength": 1 },
          "relativePath": { "type": "string", "minLength": 1 }
        }
      },
      "pages": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "text"],
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "text": { "type": "string" }
          }
        }
      },
      "targetedCurrentState": { "type": "array", "items": { "type": "object" } },
      "extractionVersion": { "type": "string", "minLength": 1 }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["skillId", "skillVersion", "executionProvenance", "status", "executionId", "mode", "artifact", "pages", "candidateAssertions", "sourceStatementInventory", "questions"],
    "properties": {
      "skillId": { "const": "atlas.prd-extraction" },
      "skillVersion": { "const": "1.2.0" },
      "executionProvenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skillId", "skillVersion", "mode"],
        "properties": {
          "skillId": { "const": "atlas.prd-extraction" },
          "skillVersion": { "const": "1.2.0" },
          "mode": { "enum": ["codex", "agents_bridge"] }
        }
      },
      "status": { "enum": ["complete", "needs_resolution"] },
      "executionId": { "type": "string", "minLength": 1 },
      "mode": { "enum": ["codex", "agents_bridge"] },
      "artifact": { "type": "object", "additionalProperties": false, "required": ["artifactId", "workspaceId", "name", "type", "size", "relativePath", "sha256", "verifiedSha256"], "properties": { "artifactId": { "type": "string", "minLength": 1 }, "workspaceId": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "type": { "const": "application/pdf" }, "size": { "type": "integer", "minimum": 1 }, "relativePath": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "minLength": 1 }, "verifiedSha256": { "type": "string", "minLength": 1 } } },
      "pages": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["page", "text"], "properties": { "page": { "type": "integer", "minimum": 1 }, "text": { "type": "string" } } } },
      "candidateAssertions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidateId", "kind", "semanticKey", "payload", "relationships", "evidence"],
          "properties": {
            "candidateId": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "semanticKey": { "type": "string", "minLength": 1 },
            "payload": { "type": "object" },
            "relationships": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "possibleAffectedSemanticKey": { "type": ["string", "null"] },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifactId", "page", "quote"],
              "properties": {
                "artifactId": { "type": "string", "minLength": 1 },
                "page": { "type": "integer", "minimum": 1 },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      },
      "sourceStatementInventory": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["inventoryId", "artifactId", "page", "quote", "classification", "normalizedInterpretation", "destination"], "properties": { "inventoryId": { "type": "string", "minLength": 1 }, "artifactId": { "type": "string", "minLength": 1 }, "page": { "type": "integer", "minimum": 1 }, "quote": { "type": "string" }, "classification": { "enum": ["material", "non_fact", "empty_page"] }, "normalizedInterpretation": { "type": "object" }, "destination": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "enum": ["candidate_assertion", "non_fact"] }, "candidateId": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "duplicateOf": { "type": "string", "minLength": 1 } } } } } },
      "questions": { "type": "array", "items": { "type": "object" } }
    }
  }
}
