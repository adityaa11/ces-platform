{
  "contractVersion": "1.0",
  "id": "atlas.fixture-projections",
  "version": "1.1.0",
  "instructionFile": "SKILL.md",
  "execution": { "kind": "reasoning", "resultDisposition": "candidate-only", "requiresDeterministicValidation": true },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["branch", "headRevision", "resolvedFacts", "requestedSurfaces"],
    "properties": {
      "branch": { "type": "object", "required": ["branchId", "headRevisionId"], "properties": { "branchId": { "type": "string", "minLength": 1 }, "headRevisionId": { "type": "string", "minLength": 1 } } },
      "headRevision": { "type": "object", "required": ["revisionId"], "properties": { "revisionId": { "type": "string", "minLength": 1 } } },
      "resolvedFacts": { "type": "array", "items": { "type": "object", "required": ["assertionId", "semanticKey", "value"], "properties": { "assertionId": { "type": "string", "minLength": 1 }, "semanticKey": { "type": "string", "minLength": 1 }, "value": {} } } },
      "dependencies": { "type": "array", "items": { "type": "object", "required": ["fromId", "toId"], "properties": { "fromId": { "type": "string", "minLength": 1 }, "toId": { "type": "string", "minLength": 1 } } } },
      "requestedSurfaces": { "type": "array", "items": { "enum": ["workflow", "facts", "ces", "chatbot_context"] } }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["skillId", "skillVersion", "executionProvenance", "status", "projectionCandidate", "issues"],
    "properties": {
      "skillId": { "const": "atlas.fixture-projections" },
      "skillVersion": { "const": "1.1.0" },
      "executionProvenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skillId", "skillVersion", "mode"],
        "properties": {
          "skillId": { "const": "atlas.fixture-projections" },
          "skillVersion": { "const": "1.1.0" },
          "mode": { "enum": ["codex", "agents_bridge"] }
        }
      },
      "status": { "enum": ["complete", "needs_resolution"] },
      "projectionCandidate": {
        "type": "object",
        "required": ["branchId", "headRevisionId", "surfaces"],
        "properties": {
          "branchId": { "type": "string", "minLength": 1 },
          "headRevisionId": { "type": "string", "minLength": 1 },
          "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["surface", "branchId", "headRevisionId", "records"],
              "properties": {
                "surface": { "enum": ["workflow", "facts", "ces", "chatbot_context"] },
                "branchId": { "type": "string", "minLength": 1 },
                "headRevisionId": { "type": "string", "minLength": 1 },
                "records": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["recordId", "assertionIds", "dependencyIds"],
                    "properties": {
                      "recordId": { "type": "string", "minLength": 1 },
                      "assertionIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                      "dependencyIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "issues": { "type": "array", "items": { "type": "object" } }
    }
  }
}
