{
  "contractVersion": "1.0",
  "id": "atlas.fixture-projections",
  "version": "1.1.0",
  "instructionFile": "SKILL.md",
  "execution": { "kind": "reasoning", "resultDisposition": "candidate-only", "requiresDeterministicValidation": true },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["branch", "headRevision", "resolvedFacts", "requestedSurfaces"],
    "properties": {
      "branch": { "type": "object" },
      "headRevision": { "type": "object" },
      "resolvedFacts": { "type": "array", "items": { "type": "object" } },
      "dependencies": { "type": "array", "items": { "type": "object" } },
      "requestedSurfaces": { "type": "array", "items": { "enum": ["workflow", "facts", "ces", "chatbot_context"] } }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["skillId", "skillVersion", "executionProvenance", "status", "projectionCandidate", "issues"],
    "properties": {
      "skillId": { "const": "atlas.fixture-projections" },
      "skillVersion": { "const": "1.1.0" },
      "executionProvenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skillId", "skillVersion", "mode"],
        "properties": {
          "skillId": { "const": "atlas.fixture-projections" },
          "skillVersion": { "const": "1.1.0" },
          "mode": { "enum": ["codex", "agents_bridge"] }
        }
      },
      "status": { "enum": ["complete", "needs_resolution"] },
      "projectionCandidate": {
        "type": "object",
        "required": ["branchId", "headRevisionId", "surfaces"],
        "properties": {
          "branchId": { "type": "string", "minLength": 1 },
          "headRevisionId": { "type": "string", "minLength": 1 },
          "surfaces": { "type": "object" }
        }
      },
      "issues": { "type": "array", "items": { "type": "object" } }
    }
  }
}
