        "annotations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["annotationId", "candidateId", "groupId", "surface", "role", "order", "sourceLanguage", "label", "supportingCandidateIds"], "properties": { "annotationId": { "type": "string", "minLength": 1 }, "candidateId": { "type": "string", "minLength": 1 }, "groupId": { "type": "string", "minLength": 1 }, "surface": { "enum": ["workflow", "facts", "ces"] }, "role": { "enum": ["workflow_page", "workflow_step", "fact_row", "ces_assessment"] }, "order": { "type": "integer", "minimum": 1 }, "sourceLanguage": { "type": "string", "minLength": 2 }, "label": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "outcome": { "type": "string", "minLength": 1 }, "supportingCandidateIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } } }
