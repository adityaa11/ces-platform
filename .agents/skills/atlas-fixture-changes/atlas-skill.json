{
  "contractVersion": "1.0",
  "id": "atlas.fixture-changes",
  "version": "1.1.0",
  "instructionFile": "SKILL.md",
  "execution": { "kind": "reasoning", "resultDisposition": "candidate-only", "requiresDeterministicValidation": true },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["inputKind", "branch", "baseRevision", "currentState"],
    "properties": {
      "inputKind": { "enum": ["extracted_candidate", "user_correction", "merge_context"] },
      "branch": { "type": "object", "required": ["branchId", "headRevisionId"], "properties": { "branchId": { "type": "string", "minLength": 1 }, "headRevisionId": { "type": "string", "minLength": 1 } } },
      "baseRevision": { "type": "object", "required": ["revisionId"], "properties": { "revisionId": { "type": "string", "minLength": 1 } } },
      "currentState": { "type": "object", "required": ["branchId", "headRevisionId", "state"], "properties": { "branchId": { "type": "string", "minLength": 1 }, "headRevisionId": { "type": "string", "minLength": 1 }, "state": { "type": "object" } } },
      "incomingInformation": { "type": "object" },
      "sourceArtifacts": { "type": "array", "items": { "type": "object" } }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["skillId", "skillVersion", "executionProvenance", "status", "changeProposal", "questions"],
    "properties": {
      "skillId": { "const": "atlas.fixture-changes" },
      "skillVersion": { "const": "1.1.0" },
      "executionProvenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skillId", "skillVersion", "mode"],
        "properties": {
          "skillId": { "const": "atlas.fixture-changes" },
          "skillVersion": { "const": "1.1.0" },
          "mode": { "enum": ["codex", "agents_bridge"] }
        }
      },
      "status": { "enum": ["complete", "needs_resolution", "conflict"] },
      "changeProposal": {
        "type": ["object", "null"],
        "required": ["proposalId", "branchId", "baseRevisionId", "targetSemanticKey", "status"],
        "properties": {
          "proposalId": { "type": "string", "minLength": 1 },
          "branchId": { "type": "string", "minLength": 1 },
          "baseRevisionId": { "type": "string", "minLength": 1 },
          "targetSemanticKey": { "type": "string", "minLength": 1 },
          "status": { "enum": ["staged", "needs_resolution", "conflict"] }
        }
      },
      "questions": { "type": "array", "items": { "type": "object" } }
    }
  }
}
