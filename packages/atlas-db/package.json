{
  "name": "@atlas/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node scripts/migrate.mjs",
    "migration:check": "node scripts/migrate.mjs --check",
    "test:admin-bootstrap-state": "node --test tests/admin-bootstrap-state.test.mjs",
    "test:permissions": "node --test tests/permissions.test.mjs",
    "test:perception-authority": "jiti tests/perception-authority.integration.test.ts",
    "test:derived-assets": "jiti tests/derived-assets.integration.test.ts",
    "test:project-repository": "jiti tests/project-repository.integration.test.ts",
    "test:staged-perception-admission": "jiti tests/staged-perception-admission.integration.test.ts",
    "test:semantic-foundation": "jiti tests/semantic-foundation.integration.test.ts",
    "test:extraction-acceptance": "jiti tests/extraction-acceptance.integration.test.ts",
    "test:reconciliation-acceptance": "jiti tests/reconciliation-acceptance.integration.test.ts",
    "test:ghr-02a": "jiti tests/ghr-02a-immutable-issuance.integration.test.ts",
    "test:ghr-02a-boundary": "node --test tests/ghr-02a-boundary.test.mjs",
    "test:ghr-02b": "jiti tests/ghr-02b-atomic-publication.integration.test.ts",
    "test:ghr-02b-boundary": "node --test tests/ghr-02b-boundary.test.mjs",
    "test:ghr-03b-boundary": "node --test tests/ghr-03b-boundary.test.mjs"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@atlas/core": "workspace:*",
    "@atlas/document-store": "workspace:*",
    "@atlas/skills": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.8",
    "jiti": "2.7.0",
    "pg-boss": "12.32.0"
  }
}
